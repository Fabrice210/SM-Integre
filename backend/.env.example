# Copier en .env (dev) ou fournir ces variables à l'environnement (prod).
# Référence complète : docs/DEPLOIEMENT.md.
DEBUG=true
SECRET_KEY=change-me-with-a-long-random-string-of-50-chars-min
ALLOWED_HOSTS=localhost,127.0.0.1
# Sans DATABASE_URL : SQLite (backend/db.sqlite3)
# DATABASE_URL=postgres://sm:sm@localhost:5432/sm_integre
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4180
# CSRF_TRUSTED_ORIGINS=https://sm.exemple.bj
DEMO_PASSWORD=Demo-SM-2026!
# Assistant IA (API Claude) : sans clé, POST /api/v1/assistant/ask/ répond 503 {fallback: true}.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-opus-5

# --- Sécurité HTTPS (valeurs par défaut hors DEBUG) ---
# SECURE_SSL_REDIRECT=true           # false si le proxy TLS redirige déjà HTTP -> HTTPS
# SECURE_HSTS_SECONDS=3600           # 31536000 une fois HTTPS validé ; 0 si le proxy pose HSTS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# --- Journalisation ---
# LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT=text                    # json par défaut hors DEBUG

# --- Onboarding et e-mails ---
# ALLOW_SIGNUP=false                 # true : POST /api/v1/auth/signup/ crée un organisme
# Base des liens envoyés par e-mail (invitation, mot de passe oublié).
FRONTEND_URL=http://localhost:5174
# PASSWORD_SET_PATH=/definir-mot-de-passe
# PASSWORD_RESET_TIMEOUT=259200      # validité des liens (s)
# Sans EMAIL_HOST (ou en DEBUG) : e-mails affichés dans la console.
# EMAIL_HOST=smtp.exemple.bj
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=SM Intégré <no-reply@exemple.bj>

# --- Pièces jointes ---
# Disque par défaut (MEDIA_ROOT) ; S3 ou compatible si AWS_STORAGE_BUCKET_NAME est défini.
# MEDIA_ROOT=/var/lib/sm-integre/media
# AWS_STORAGE_BUCKET_NAME=sm-integre-pieces
# AWS_S3_REGION_NAME=eu-west-3
# AWS_S3_ENDPOINT_URL=http://localhost:9000   # MinIO, Scaleway, OVH…
# AWS_S3_ADDRESSING_STYLE=path                # MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
