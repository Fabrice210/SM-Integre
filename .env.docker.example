# Variables de la pile docker compose. Copier en .env à la racine :
#   cp .env.docker.example .env
# puis remplacer au minimum SECRET_KEY et POSTGRES_PASSWORD. Référence : docs/DEPLOIEMENT.md.

# --- PostgreSQL (éviter les caractères @ : / ? # dans le mot de passe : il entre dans une URL) ---
POSTGRES_DB=sm_integre
POSTGRES_USER=sm
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-long-random-string-of-50-chars-min
DEBUG=false
# Noms d'hôte servis (sans port ni schéma), séparés par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1
# Inutile en même origine (proxy nginx) ; seulement si un autre domaine appelle l'API.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Origines de confiance (avec schéma) pour l'admin Django derrière le proxy TLS.
# CSRF_TRUSTED_ORIGINS=https://sm.exemple.bj
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
GUNICORN_WORKERS=3

# --- Assistant IA (API Claude) ---
# Sans clé, l'assistant du front reste sur son moteur local (réponses à règles fixes).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_RATE=30/hour
# ASSISTANT_TIMEOUT=45
# --- HTTPS (proxy TLS devant le port du front) ---
# false : la redirection HTTP -> HTTPS est faite par le proxy TLS (et la pile locale reste en HTTP).
SECURE_SSL_REDIRECT=false
# HSTS envoyé sur les requêtes HTTPS : 3600 pour commencer, 31536000 une fois HTTPS validé.
SECURE_HSTS_SECONDS=3600

# --- Journaux (sortie standard : docker compose logs backend) ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Onboarding et e-mails ---
# true : inscription publique d'un nouvel organisme (POST /api/v1/auth/signup/).
ALLOW_SIGNUP=false
# URL publique du front, base des liens d'invitation / de mot de passe oublié.
FRONTEND_URL=http://localhost:8080
# Sans EMAIL_HOST, les e-mails sont écrits dans les journaux du backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SM Intégré <no-reply@localhost>

# --- Pièces jointes : volume `media` par défaut, S3 ou compatible si le bucket est défini ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Démo ---
# 1 = charge l'organisme AGRO-BÉNIN et ses 14 comptes au démarrage (sans effet s'il existe déjà).
LOAD_DEMO=1
DEMO_PASSWORD=Demo-SM-2026!

# --- Front ---
# URL de l'API vue du navigateur, figée au build : même origine via le proxy nginx.
VITE_API_URL=/api/v1
FRONT_PORT=8080
