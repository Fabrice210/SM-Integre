# Copier en .env.local pour brancher le front sur l'API Django (backend/).
# Sans VITE_API_URL, l'app reste 100 % locale : démo, localStorage, connexion factice.
VITE_API_URL=http://localhost:8000/api/v1
# L'origine du front doit figurer dans CORS_ALLOWED_ORIGINS du backend (npm run dev : 5174).
# Variante sans CORS en dev : passer par le proxy de Vite (vite.config.ts -> localhost:8000).
# VITE_API_URL=/api/v1
